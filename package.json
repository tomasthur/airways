{
  "name": "airline-pilot",
  "version": "0.1.3",
  "private": true,
  "description": "Airline Pilot – Prototype 01: Bratislava to Vienna. Side-scrolling 3D airplane game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "simulate": "node scripts/simulate.ts",
    "test:flight": "node scripts/regression/flights.mjs",
    "perf:android": "node scripts/perf/android-baseline.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run cap:sync && node scripts/android-apk.mjs",
    "android:aab": "npm run cap:sync && node scripts/android-aab.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.4",
    "@capgo/native-purchases": "^7.19.3",
    "convex": "^1.49.0",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "ws": "^8.22.1"
  }
}
