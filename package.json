{
  "name": "airline-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Airline Pilot – Prototype 01: Bratislava to Vienna. Side-scrolling 3D airplane game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "simulate": "node scripts/simulate.ts",
    "test:flight": "node scripts/regression/flights.mjs",
    "perf:android": "node scripts/perf/android-baseline.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run cap:sync && node scripts/android-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
